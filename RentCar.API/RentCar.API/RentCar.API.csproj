<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>RentCarRD-Api-Development</UserSecretsId>
    <Version>1.2.1</Version>
    <!-- Auditoría NuGet en cada restore, incluyendo dependencias transitivas.
         Las vulnerabilidades moderadas, altas y críticas detienen la compilación. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RentCar.API.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.0" />
  </ItemGroup>

  <!-- Fijación explícita de dependencias transitivas a versiones corregidas.
       No ocultan avisos: elevan el paquete vulnerable a la versión que publica el parche.
       - Microsoft.OpenApi 2.4.1 (vía Swashbuckle / AspNetCore.OpenApi): GHSA-v5pm-xwqc-g5wc, corregido en 2.7.5.
       - System.Security.Cryptography.Pkcs 9.0.4 (vía Microsoft.Data.SqlClient):
         GHSA-846f-f764-76mx y GHSA-2fmv-rv2c-59x7, corregidos en 10.0.13 (se usa el último parche 10.0.15).
       Revisar y retirar cuando los paquetes directos las referencien por sí mismos. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

</Project>
